<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proiect.MainController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" text="Delete" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
  <center>
    <TabPane BorderPane.alignment="CENTER">
      <tabs>
        <Tab text="Clients">
          <content>
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="200.0" vgrow="ALWAYS" />
              </rowConstraints>
              <children>
                <Label text="Nume" GridPane.rowIndex="0" />
                <TextField fx:id="clientNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Email" GridPane.rowIndex="1" />
                <TextField fx:id="clientEmailField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="CNP" GridPane.rowIndex="2" />
                <TextField fx:id="clientCnpField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Telefon" GridPane.rowIndex="3" />
                <TextField fx:id="clientPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Button mnemonicParsing="false" onAction="#handleAddClient" text="Adaugă client" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                <ListView fx:id="clientListView" prefHeight="200.0" prefWidth="400.0" GridPane.rowIndex="5" GridPane.columnSpan="2" />
              </children>
            </GridPane>
          </content>
        </Tab>
        <Tab text="Vehicles">
          <content>
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="200.0" vgrow="ALWAYS" />
              </rowConstraints>
              <children>
                <Label text="Marca" GridPane.rowIndex="0" />
                <TextField fx:id="vehicleMakeField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Model" GridPane.rowIndex="1" />
                <TextField fx:id="vehicleModelField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="An" GridPane.rowIndex="2" />
                <TextField fx:id="vehicleYearField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Tarif zilnic" GridPane.rowIndex="3" />
                <TextField fx:id="vehicleRateField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Button mnemonicParsing="false" onAction="#handleAddVehicle" text="Adaugă vehicul" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                <ListView fx:id="vehicleListView" prefHeight="200.0" prefWidth="400.0" GridPane.rowIndex="5" GridPane.columnSpan="2" />
              </children>
            </GridPane>
          </content>
        </Tab>
      </tabs>
    </TabPane>
  </center>
</BorderPane>
